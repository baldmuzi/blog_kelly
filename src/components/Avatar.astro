---
interface Props { size?: 'sm' | 'md' | 'lg' }
const { size = 'md' } = Astro.props
---

<span class:list={['avatar', `avatar--${size}`]} aria-hidden="true">K</span>

<style>
  .avatar { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 10px; background: var(--accent); color: #fff; font-weight: 800; letter-spacing: -.03em; }
  .avatar--sm { width: 32px; height: 32px; border-radius: 8px; font-size: .95rem; }
  .avatar--md { width: 60px; height: 60px; font-size: 1.6rem; }
  .avatar--lg { width: 84px; height: 84px; border-radius: 14px; font-size: 2.1rem; }
</style>
