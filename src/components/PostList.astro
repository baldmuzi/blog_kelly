---
import type { CollectionEntry } from 'astro:content'
import { withBase } from '../utils/links'

interface Props { posts: CollectionEntry<'blog'>[]; variant?: 'bento' | 'list' }
const { posts, variant = 'bento' } = Astro.props
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' }).format(date)
---

{posts.length ? (
  <ol class:list={['post-grid', `post-grid--${variant}`]}>
    {posts.map((post, index) => (
      <li class:list={['post-card', { 'post-card--featured': variant === 'bento' && index === 0 }]}>
        <a href={withBase(`/blog/${post.id}`)} class="post-card__link">
          <div class="post-card__topline"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>{post.data.tags[0] && <span>{post.data.tags[0]}</span>}</div>
          <div class="post-card__body"><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
          <div class="post-card__bottom"><span>{post.data.tags.length ? post.data.tags.join(' · ') : '未分类'}</span><span class="post-card__read">阅读文章 <span aria-hidden="true">→</span></span></div>
        </a>
      </li>
    ))}
  </ol>
) : <p class="empty-state">还没有发布文章。</p>}
