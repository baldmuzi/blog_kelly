---
import type { CollectionEntry } from 'astro:content'
import { withBase } from '../utils/links'

interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(date).replaceAll('/', '.')
---

<ol class="border-t border-ink/25">
  {posts.map((post, index) => (
    <li class="grid grid-cols-12 border-b border-ink/25 transition-colors hover:bg-ink hover:text-paper">
      <span class="col-span-2 border-r border-ink/25 px-3 py-5 text-sm tabular-nums sm:px-5">{String(index + 1).padStart(2, '0')}</span>
      <a href={withBase(`/blog/${post.id}`)} class="col-span-10 grid gap-2 px-4 py-5 focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-signal sm:grid-cols-12 sm:px-6">
        <span class="text-lg font-semibold tracking-tight sm:col-span-8">{post.data.title}</span>
        <span class="text-sm opacity-70 sm:col-span-4 sm:text-right">{formatDate(post.data.pubDate)}</span>
        <span class="text-sm leading-6 opacity-75 sm:col-span-9">{post.data.description}</span>
        <span class="text-xs font-medium tracking-wide opacity-60 sm:col-span-3 sm:text-right">{post.data.tags.join(' · ')}</span>
      </a>
    </li>
  ))}
</ol>
