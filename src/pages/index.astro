---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostList from '../components/PostList.astro'
import { withBase } from '../utils/links'

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const tagCount = new Set(posts.flatMap((post) => post.data.tags)).size
const latestYear = posts[0] ? new Intl.DateTimeFormat('zh-CN', { year: 'numeric' }).format(posts[0].data.pubDate) : '—'
---

<BaseLayout title="LJX Notes — 个人博客">
  <main class="page-stack">
    <section class="bento-hero" aria-labelledby="home-title">
      <div class="bento-card intro-card">
        <p class="eyebrow">个人知识库</p>
        <h1 id="home-title">把思考写下来，<br />留给未来的自己。</h1>
        <p class="intro-card__summary">这里收集关于开发、学习和日常观察的笔记。内容保持简单，也保持诚实。</p>
        <a class="text-link" href={withBase('/blog')}>浏览全部文章 <span aria-hidden="true">→</span></a>
      </div>
      <div class="bento-card index-card index-card--about"><p class="eyebrow">关于本站</p><p>一个为记录而建的轻量博客，使用 Astro 生成静态页面。</p><a class="text-link" href={withBase('/about')}>了解更多 <span aria-hidden="true">→</span></a></div>
      <div class="bento-card index-card index-card--stat"><p class="index-card__number">{posts.length}</p><p>篇已发布文章</p></div>
      <div class="bento-card index-card index-card--stat"><p class="index-card__number">{tagCount}</p><p>个主题标签</p></div>
      <div class="bento-card index-card index-card--date"><p class="eyebrow">最新记录</p><p class="index-card__year">{latestYear}</p></div>
    </section>
    <section class="section-heading" aria-labelledby="latest-title"><div><p class="eyebrow">最新内容</p><h2 id="latest-title">最近发布</h2></div><a class="text-link" href={withBase('/blog')}>所有文章 <span aria-hidden="true">→</span></a></section>
    <PostList posts={posts.slice(0, 5)} />
  </main>
</BaseLayout>
