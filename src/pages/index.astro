---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Avatar from '../components/Avatar.astro'
import HomeArticles from '../components/HomeArticles.tsx'
import { withBase } from '../utils/links'
import { siteConfig } from '../utils/site'
import { CATEGORIES } from '../content.config'
import { estimateReadingTime } from '../utils/reading-time'

const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date).replace(/\//g, '.')

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const articles = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  tags: post.data.tags,
  dateLabel: formatDate(post.data.pubDate),
  dateISO: post.data.pubDate.toISOString(),
  readingTime: estimateReadingTime(post.body ?? ''),
}))
---

<BaseLayout title={`${siteConfig.name} — ${siteConfig.author} 的个人博客`}>
  <main class="page-stack">
    <section class="profile-hero bento-card">
      <Avatar size="lg" />
      <div class="profile-hero__content">
        <p class="eyebrow">你好，我是</p>
        <h1>{siteConfig.author}</h1>
        <p class="profile-hero__bio">{siteConfig.bio}</p>
        <div class="tag-pills">
          {siteConfig.tags.map((tag) => <span class="tag-pill">{tag}</span>)}
        </div>
      </div>
    </section>

    <HomeArticles client:load posts={articles} categories={[...CATEGORIES]} blogPath={withBase('/blog')} />

    <section class="about-summary bento-card">
      <Avatar size="sm" />
      <div class="about-summary__content">
        <p class="eyebrow">关于我</p>
        <p>大家好，我是{siteConfig.author}，{siteConfig.role}。{siteConfig.bio}</p>
        <a class="text-link" href={withBase('/about')}>查看完整经历与项目 <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
