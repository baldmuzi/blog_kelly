---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostList from '../../components/PostList.astro'

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const tags = [...new Set(posts.flatMap((post) => post.data.tags))]
---

<BaseLayout title="文章 — LJX Notes">
  <main class="page-stack">
    <section class="archive-header bento-card"><div><p class="eyebrow">文章归档</p><h1>所有记录</h1></div><p>按时间倒序整理。新的文章会直接出现在这里。</p></section>
    {tags.length > 0 && <section class="tag-index bento-card" aria-label="文章标签"><p class="eyebrow">主题</p><div class="tag-index__items">{tags.map((tag) => <span>{tag}</span>)}</div></section>}
    <PostList posts={posts} variant="list" />
  </main>
</BaseLayout>
