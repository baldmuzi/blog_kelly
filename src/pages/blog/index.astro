---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ArchiveExplorer from '../../components/ArchiveExplorer.vue'
import { withBase } from '../../utils/links'
import { CATEGORIES } from '../../content.config'
import { estimateReadingTime } from '../../utils/reading-time'

const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date).replace(/\//g, '.')

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const articles = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  tags: post.data.tags,
  dateLabel: formatDate(post.data.pubDate),
  dateISO: post.data.pubDate.toISOString(),
  readingTime: estimateReadingTime(post.body ?? ''),
}))

const tagCounts = new Map<string, number>()
for (const post of posts) for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)
const commonTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6).map(([tag]) => tag)
---

<BaseLayout title="全部文章 — Kelly.log">
  <main class="page-stack">
    <section class="archive-header bento-card">
      <div>
        <p class="eyebrow">文章归档</p>
        <h1>全部记录</h1>
      </div>
      <p>共 {posts.length} 篇文章 · 按发布时间排序</p>
    </section>
    <ArchiveExplorer client:load posts={articles} categories={[...CATEGORIES]} tags={commonTags} blogPath={withBase('/blog')} />
  </main>
</BaseLayout>
