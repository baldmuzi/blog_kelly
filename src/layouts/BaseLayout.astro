---
import '../styles/global.css'
import ThemeToggle from '../components/ThemeToggle.vue'
import { withBase } from '../utils/links'

interface Props { title?: string; description?: string }

const { title = 'LJX Notes', description = 'LJX 的个人博客，记录开发、学习和日常观察。' } = Astro.props
const navItems = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '文章' },
  { href: '/about', label: '关于' },
]
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('blog_ljx-theme')
      document.documentElement.classList.toggle('dark', savedTheme === 'dark')
    </script>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a href={withBase()} class="wordmark" aria-label="LJX Notes 首页">
          <span class="wordmark__main">ljx</span><span class="wordmark__sub">notes</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {navItems.map((item) => (
            <a class:list={['site-nav__link', { 'is-active': Astro.url.pathname === withBase(item.href) }]} href={withBase(item.href)}>{item.label}</a>
          ))}
          <ThemeToggle client:load />
        </nav>
      </header>
      <slot />
      <footer class="site-footer"><span>© {new Date().getFullYear()} LJX</span><span>使用 Astro 构建</span></footer>
    </div>
  </body>
</html>
