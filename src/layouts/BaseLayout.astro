---
import '../styles/global.css'
import ThemeToggle from '../components/ThemeToggle.vue'
import Avatar from '../components/Avatar.astro'
import { withBase } from '../utils/links'
import { siteConfig, navItems } from '../utils/site'

interface Props { title?: string; description?: string }

const { title = `${siteConfig.name} — ${siteConfig.author} 的个人博客`, description = siteConfig.bio } = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('blog_ljx-theme')
      document.documentElement.classList.toggle('dark', savedTheme === 'dark')
    </script>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a href={withBase()} class="wordmark" aria-label={`${siteConfig.name} 首页`}>
          <Avatar size="sm" />
          <span class="wordmark__text">{siteConfig.name}</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {navItems.map((item) => (
            <a class:list={['site-nav__link', { 'is-active': Astro.url.pathname === withBase(item.href) }]} href={withBase(item.href)}>{item.label}</a>
          ))}
        </nav>
        <div class="site-header__actions">
          {siteConfig.social.map((link) => (
            <a class="social-link" href={link.href} target="_blank" rel="noreferrer"><span aria-hidden="true">↗</span> {link.label}</a>
          ))}
          <ThemeToggle client:load />
        </div>
      </header>
      <slot />
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {siteConfig.author}. Built with care.</span>
        <div class="site-footer__links">
          {siteConfig.social.map((link) => (
            <a class="social-link" href={link.href} target="_blank" rel="noreferrer"><span aria-hidden="true">↗</span> {link.label}</a>
          ))}
        </div>
      </footer>
    </div>
  </body>
</html>
